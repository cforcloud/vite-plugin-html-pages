{
  "name": "vite-plugin-html-pages",
  "version": "0.0.0",
  "description": "Vite plugin to support multiple pages with single HTML",
  "keywords": [
    "html",
    "mpa",
    "vite-plugin"
  ],
  "homepage": "https://github.com/cforcloud/vite-plugin-html-pages",
  "bugs": {
    "url": "https://github.com/cforcloud/vite-plugin-html-pages/issues"
  },
  "license": "MIT",
  "author": "cforcloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/cforcloud/vite-plugin-html-pages"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "pnpm typecheck && obuild",
    "build:stub": "obuild --stub",
    "dev:basic": "pnpm --filter ./playground/basic run dev",
    "dev:multi": "pnpm --filter ./playground/multi-page run dev",
    "dev:build": "pnpm --filter 'playground-*' run build",
    "fmt": "automd && oxlint . --fix --fix-suggestions && oxfmt .",
    "lint": "oxlint . && oxfmt .",
    "prepack": "pnpm build",
    "release": "pnpm test && pnpm build && changelogen --release && npm publish && git push --follow-tags",
    "test:dev": "vitest --reporter=tree",
    "test": "pnpm lint && pnpm typecheck && vitest run --coverage",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "ready": "pnpm lint && pnpm fmt && pnpm build:stub && pnpm build && pnpm dev:build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:testing",
    "automd": "catalog:cli",
    "changelogen": "catalog:cli",
    "obuild": "catalog:cli",
    "oxfmt": "catalog:cli",
    "oxlint": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
